# Copy this file to .env at the repo root. Never commit the real .env.
# The API and the web app read this one file.

# ---- Django API (apps/api) ----
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to call the API from a browser (the Vite dev server by default).
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Leave POSTGRES_DB empty to use SQLite (apps/api/db.sqlite3).
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ---- Email ----
# Local development: the console backend prints every email to the API terminal.
# Production: use the SMTP backend below and set a real host/user/password.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_PORT=587
EMAIL_TIMEOUT=15
TEAM_EMAIL=team@example.com
DEFAULT_FROM_EMAIL=Axora Finds <no-reply@example.com>
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Absolute frontend URL used in email links (no trailing slash).
SITE_URL=http://localhost:5173

# To send through Gmail, use an App Password (not your normal password):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_USE_TLS=1
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your16characterapppassword (do not include the display spaces)
# DEFAULT_FROM_EMAIL=Axora Finds <you@gmail.com>
# If port 587 is blocked ("Connection unexpectedly closed"), use Gmail's SSL port:
# EMAIL_PORT=465
# EMAIL_USE_TLS=0
# EMAIL_USE_SSL=1

# ---- Web (apps/web) ----
# Dev proxy target for /api and /media.
VITE_API_PROXY=http://127.0.0.1:8000
# Production: full API URL when the API lives on another origin, e.g. https://api.example.com/api
VITE_API_BASE=/api
